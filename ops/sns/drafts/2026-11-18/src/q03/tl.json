{"tl": [{"t0": 0.0, "who": "host", "text": "値段クイズ！ 愛知県の、築5年以内の家。いくらで売れたでしょう？", "panel": "q1", "confetti": false, "clip": "01", "len": 4.839342}, {"t0": 4.839342, "who": "host", "text": "A 2,800万円／B 3,700万円／C 4,600万円！", "panel": "q1", "confetti": false, "clip": "02", "len": 5.5887530000000005}, {"t0": 10.428095, "who": "sota", "text": "Cでしょ！ 新しいもん！", "panel": "q1", "confetti": false, "clip": "03", "len": 2.494603}, {"t0": 12.922698, "who": "miho", "text": "うーん、Bかな。", "panel": "q1", "confetti": false, "clip": "04", "len": 1.879229}, {"t0": 14.801927000000001, "who": "kenji", "text": "Aじゃないか？", "panel": "q1", "confetti": false, "clip": "05", "len": 1.0898189999999999}, {"t0": 15.891746000000001, "who": "kenji", "text": "", "panel": "q1", "count": 3, "clip": "idle-kenji", "len": 0.7}, {"t0": 16.591746, "who": "miho", "text": "", "panel": "q1", "count": 2, "clip": "idle-miho", "len": 0.7}, {"t0": 17.291746, "who": "sota", "text": "", "panel": "q1", "count": 1, "clip": "idle-sota", "len": 0.7}, {"t0": 17.991746, "who": "host", "text": "正解は、B！ 3,700万円です！", "panel": "a1", "confetti": true, "clip": "06", "len": 3.0489800000000002}, {"t0": 21.040726, "who": "miho", "text": "やった、また当たった！", "panel": "a1", "confetti": false, "clip": "07", "len": 2.134512}, {"t0": 23.175238, "who": "sota", "text": "えー、外れた！", "panel": "a1", "confetti": false, "clip": "08", "len": 2.009274}, {"t0": 25.184512, "who": "host", "text": "第2問！ 新しい家、高いのは埼玉県？北海道？", "panel": "q2", "confetti": false, "clip": "09", "len": 8.728821}, {"t0": 33.913333, "who": "hana", "text": "さいたま！", "panel": "q2", "confetti": false, "clip": "10", "len": 1.3935369999999998}, {"t0": 35.30687, "who": "kenji", "text": "埼玉だろ。", "panel": "q2", "confetti": false, "clip": "11", "len": 1.0898189999999999}, {"t0": 36.396689, "who": "miho", "text": "ほぼ同じ、だったりして。", "panel": "q2", "confetti": false, "clip": "12", "len": 2.435896}, {"t0": 38.832585, "who": "miho", "text": "", "panel": "q2", "count": 3, "clip": "idle-miho", "len": 0.7}, {"t0": 39.532585000000005, "who": "kenji", "text": "", "panel": "q2", "count": 2, "clip": "idle-kenji", "len": 0.7}, {"t0": 40.23258500000001, "who": "hana", "text": "", "panel": "q2", "count": 1, "clip": "idle-hana", "len": 0.7}, {"t0": 40.93258500000001, "who": "host", "text": "正解は、C！ 埼玉県3,600万円、北海道3,700万円。ほぼ同じ！", "panel": "a2", "confetti": true, "clip": "13", "len": 7.300658}, {"t0": 48.23324300000001, "who": "kenji", "text": "北海道のほうが、高いのか！", "panel": "a2", "confetti": false, "clip": "14", "len": 2.424966}, {"t0": 50.65820900000001, "who": "miho", "text": "新しい家は、どこも高いんだね。", "panel": "end", "confetti": false, "clip": "15", "len": 3.2259640000000003}, {"t0": 53.884173000000004, "who": "host", "text": "何問正解できたかな？ コメントで教えてね！", "panel": "end", "confetti": false, "clip": "17", "len": 4.3610880000000005}], "aud": [["01", 0.0], ["02", 4.839342], ["03", 10.428095], ["04", 12.922698], ["05", 14.801927000000001], ["06", 17.991746], ["07", 21.040726], ["08", 23.175238], ["09", 25.184512], ["10", 33.913333], ["11", 35.30687], ["12", 36.396689], ["13", 40.93258500000001], ["14", 48.23324300000001], ["15", 50.65820900000001], ["17", 53.884173000000004]], "sfx": [["whoosh", 0], ["tick", 15.891746000000001], ["tick", 16.591746], ["tick", 17.291746], ["ding", 17.991746], ["whoosh", 25.184512], ["tick", 38.832585], ["tick", 39.532585000000005], ["tick", 40.23258500000001], ["ding", 40.93258500000001]], "total": 58.245261000000006}