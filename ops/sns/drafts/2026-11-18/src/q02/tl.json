{"tl": [{"t0": 0.0, "who": "host", "text": "値段クイズ！ 北海道の、築41年以上の家。いくらで売れたでしょう？", "panel": "q1", "confetti": false, "clip": "01", "len": 5.710227}, {"t0": 5.710227, "who": "host", "text": "A 520万円／B 1,500万円／C 2,400万円！", "panel": "q1", "confetti": false, "clip": "02", "len": 5.292177}, {"t0": 11.002403999999999, "who": "sota", "text": "C！ 家だもん、高いでしょ！", "panel": "q1", "confetti": false, "clip": "03", "len": 2.5990930000000003}, {"t0": 13.601496999999998, "who": "miho", "text": "古いから、Bくらいかな。", "panel": "q1", "confetti": false, "clip": "04", "len": 2.424875}, {"t0": 16.026372, "who": "kenji", "text": "いや、Aじゃないか？", "panel": "q1", "confetti": false, "clip": "05", "len": 1.589048}, {"t0": 17.61542, "who": "kenji", "text": "", "panel": "q1", "count": 3, "clip": "idle-kenji", "len": 0.7}, {"t0": 18.31542, "who": "miho", "text": "", "panel": "q1", "count": 2, "clip": "idle-miho", "len": 0.7}, {"t0": 19.01542, "who": "sota", "text": "", "panel": "q1", "count": 1, "clip": "idle-sota", "len": 0.7}, {"t0": 19.715419999999998, "who": "host", "text": "正解は、A！ 520万円です！", "panel": "a1", "confetti": true, "clip": "06", "len": 3.1052150000000003}, {"t0": 22.820635, "who": "kenji", "text": "よし、当たった！", "panel": "a1", "confetti": false, "clip": "07", "len": 1.414898}, {"t0": 24.235533, "who": "miho", "text": "そんなに安いの？", "panel": "a1", "confetti": false, "clip": "08", "len": 2.020794}, {"t0": 26.256327, "who": "host", "text": "第2問！ 同じくらい古い家、東京都だと？", "panel": "q2", "confetti": false, "clip": "09", "len": 8.055397}, {"t0": 34.311724, "who": "hana", "text": "A！", "panel": "q2", "confetti": false, "clip": "10", "len": 1.047755}, {"t0": 35.359479, "who": "kenji", "text": "Bだろ。", "panel": "q2", "confetti": false, "clip": "11", "len": 0.799569}, {"t0": 36.159048, "who": "miho", "text": "もしかして、C？", "panel": "q2", "confetti": false, "clip": "12", "len": 1.9953059999999998}, {"t0": 38.154354, "who": "miho", "text": "", "panel": "q2", "count": 3, "clip": "idle-miho", "len": 0.7}, {"t0": 38.854354, "who": "kenji", "text": "", "panel": "q2", "count": 2, "clip": "idle-kenji", "len": 0.7}, {"t0": 39.554354000000004, "who": "hana", "text": "", "panel": "q2", "count": 1, "clip": "idle-hana", "len": 0.7}, {"t0": 40.254354000000006, "who": "host", "text": "正解は、C！ 4,800万円。北海道の9倍以上！", "panel": "a2", "confetti": true, "clip": "13", "len": 5.0832880000000005}, {"t0": 45.33764200000001, "who": "kenji", "text": "古くても、そんなにするのか！", "panel": "a2", "confetti": false, "clip": "14", "len": 2.320476}, {"t0": 47.65811800000001, "who": "miho", "text": "土地の値段が、大きいのかもね。", "panel": "end", "confetti": false, "clip": "15", "len": 2.9815650000000002}, {"t0": 50.63968300000001, "who": "host", "text": "何問正解できたかな？ コメントで教えてね！", "panel": "end", "confetti": false, "clip": "17", "len": 4.361111}], "aud": [["01", 0.0], ["02", 5.710227], ["03", 11.002403999999999], ["04", 13.601496999999998], ["05", 16.026372], ["06", 19.715419999999998], ["07", 22.820635], ["08", 24.235533], ["09", 26.256327], ["10", 34.311724], ["11", 35.359479], ["12", 36.159048], ["13", 40.254354000000006], ["14", 45.33764200000001], ["15", 47.65811800000001], ["17", 50.63968300000001]], "sfx": [["whoosh", 0], ["tick", 17.61542], ["tick", 18.31542], ["tick", 19.01542], ["ding", 19.715419999999998], ["whoosh", 26.256327], ["tick", 38.154354], ["tick", 38.854354], ["tick", 39.554354000000004], ["ding", 40.254354000000006]], "total": 55.00079400000001}